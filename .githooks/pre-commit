#!/bin/sh
# pre-commit — route_catalog: אם ה-commit הנוכחי כולל שינוי בקבצי GPX תחת
# YR1/bike/route_catalog/GPX_files, מריץ אוטומטית את build_routes_catalog.py
# ומצרף לאותו commit את הפלט המעודכן (routes-catalog.json, תמונות ממוזערות,
# וגם קבצי GPX שהשתנו/שונה שמם על ידי הסקריפט עצמו).
#
# הפעלה (חד-פעמית, לכל שיבוט של הריפו): git config core.hooksPath .githooks
# ראו .githooks/README.md לפרטים מלאים.

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
GPX_DIR="YR1/bike/route_catalog/GPX_files"

CHANGED=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR -- "$GPX_DIR")
CHANGED_GPX=$(printf '%s\n' "$CHANGED" | grep -iE '\.gpx$')

if [ -z "$CHANGED_GPX" ]; then
  exit 0
fi

echo "pre-commit: זוהה שינוי בקבצי GPX ב-commit הזה - מריץ build_routes_catalog.py..."
echo "$CHANGED_GPX" | sed 's/^/  - /'

PYTHON_BIN="$REPO_ROOT/.venv/Scripts/python.exe"
SCRIPT_PATH="$REPO_ROOT/$GPX_DIR/scripts/build_routes_catalog.py"

if [ ! -x "$PYTHON_BIN" ] && [ ! -f "$PYTHON_BIN" ]; then
  echo "pre-commit: לא נמצא $PYTHON_BIN - ה-commit בוטל. ודא שסביבת .venv קיימת בשורש הריפו."
  exit 1
fi

PYTHONIOENCODING=utf-8 "$PYTHON_BIN" "$SCRIPT_PATH"
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo "pre-commit: build_routes_catalog.py נכשל (קוד יציאה $STATUS) - ה-commit בוטל."
  echo "pre-commit: תקן את השגיאה, ואז נסה את ה-commit שוב."
  exit 1
fi

git add "$REPO_ROOT/YR1/bike/route_catalog/data"
git add "$REPO_ROOT/$GPX_DIR"

echo "pre-commit: הקטלוג עודכן ונוסף אוטומטית ל-commit הנוכחי."
exit 0
