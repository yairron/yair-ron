  <metadata>
    <bounds maxlat="32.7993128" maxlon="35.7034132" minlat="32.708215" minlon="35.649379"></bounds>
  </metadata>
  <trk>
    <name>טיילת דרום הגולן אופניים משפחתי קל 1</name>
    <desc>טיילת סלולה לאורך מצוקי דרום הגולן. הטיילת עוברת מעל מצוקי הכנרת, נחל אל-על, עין פיק, אמפי גולן, מצפה סוסיתא. נקודות נוספות: אתר עין קשתות, מאגר בני ישראל, מועדון הקצינים הסורי בקיבוץ אפיק (תצפית נהדרת לכנרת), מצפה השלום, מצוקי האון ומצפה מבוא חמה.</desc>
    <extensions>
      <Color xmlns="">#FF6600</Color>
      <Opacity xmlns="">0.4</Opacity>
      <Weight xmlns="">9</Weight>
    </extensions>
