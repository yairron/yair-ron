        {
          "id": "q10_difficulty_types",
          "type": "checkbox",
          "required": false,
          "text": "באילו פעולות יש קושי?",
          "condition": {"q9_daily_difficulty": ["mild", "moderate", "severe"]},
          "options": [
            {"value": "bathing", "label": "רחצה"},
            {"value": "dressing", "label": "הלבשה"},
            {"value": "eating", "label": "אכילה"},
            {"value": "mobility", "label": "ניידות בבית"},
            {"value": "supervision", "label": "השגחה (דמנציה / בלבול)"}
          ],
          "impacts": ["רמת סיעוד"]
        },
        {
          "id": "q11_daily_assistance",
          "type": "radio",
          "required": true,
          "text": "האם נדרש סיוע יומיומי קבוע?",
          "options": [
            {"value": "no", "label": "לא"},
            {"value": "partial", "label": "כן - חלקי"},
            {"value": "full", "label": "כן - מלא"}
          ],
          "impacts": ["גמלת סיעוד", "שר״מ"],
          "critical": true
        }
      ]
    },
