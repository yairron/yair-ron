        {
          "id": "q14b_work_end_age",
          "type": "radio",
          "required": true,
          "text": "האם הפסקת עבודה לאחר גיל פרישה (67 גבר / 62-65 אישה)?",
          "options": [
            {"value": "yes", "label": "כן"},
            {"value": "no", "label": "לא"},
            {"value": "not_relevant", "label": "לא רלוונטי"}
          ],
          "impacts": ["דמי הסתגלות"],
          "critical": true
        }
      ]
    },
    {
      "id": "section_6",
      "title": "חלק ו׳ - מגורים וסיוע",
      "description": "סביבת מגורים ומטפלים",
      "questions": [
        {
          "id": "q15_living_situation",
          "type": "radio",
          "required": true,
          "text": "צורת מגורים",
          "options": [
            {"value": "independent", "label": "עצמאי בבית"},
            {"value": "with_partner", "label": "עם בן/בת זוג"},
            {"value": "with_caregiver", "label": "עם מטפל/ת"},
