          "options": [
            {"value": "layoff", "label": "פיטורים"},
            {"value": "closure", "label": "סגירת מקום עבודה"},
            {"value": "health", "label": "מצב בריאותי"},
            {"value": "retirement", "label": "יציאה לגמלאות"},
            {"value": "other", "label": "אחר"},
            {"value": "not_relevant", "label": "לא רלוונטי"}
