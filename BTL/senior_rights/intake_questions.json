{
  "metadata": {
    "title": "שאלון אינטק חכם - זכויות ביטוח לאומי (גרסה מעודכנת)",
    "description": "שאלון לזיהוי זכויות רלוונטיות מביטוח לאומי",
    "version": "3.0",
    "date": "2026-01-26"
  },
  "sections": [
    {
      "id": "section_0",
      "title": "חלק א׳ - פרטים בסיסיים",
      "description": "מידע ראשוני לזיהוי זכויות",
      "questions": [
        {
          "id": "q0_gender",
          "type": "radio",
          "required": true,
          "text": "מהו מינך?",
          "options": [
            {"value": "male", "label": "אני גבר"},
            {"value": "female", "label": "אני אישה"}
          ],
          "impacts": ["גיל פרישה"]
        },
        {
          "id": "q0_age",
          "type": "number",
          "required": true,
          "text": "בן/בת כמה את/ה?",
          "min": 18,
          "max": 120,
          "impacts": ["כל הקצבאות", "גיל פרישה"]
        },
        {
          "id": "q0_residency",
          "type": "radio",
          "required": true,
          "text": "מה סטטוס התושבות שלך?",
          "options": [
            {"value": "permanent", "label": "תושב ישראל קבוע"},
            {"value": "returning", "label": "תושב חוזר"},
            {"value": "abroad", "label": "שוהה בחו״ל מעל 6 חודשים בשנה"}
          ],
          "impacts": ["זכאות בסיסית"]
        }
      ]
    },
    {
      "id": "section_1",
      "title": "חלק ב׳ - מצב משפחתי",
      "description": "מידע משפחתי בסיסי",
      "questions": [
        {
          "id": "q1_marital",
          "type": "radio",
          "required": true,
          "text": "מה מצבך המשפחתי?",
          "options": [
            {"value": "single", "label": "רווק/ה"},
            {"value": "married", "label": "נשוי/אה"},
            {"value": "divorced", "label": "גרוש/ה"},
            {"value": "widowed", "label": "אלמן/ה"}
          ],
          "impacts": ["תוספות זוג"]
        },
        {
          "id": "q1_household_members",
          "type": "checkbox",
          "required": true,
          "text": "מי מבני משפחתך מתגורר איתך בבית?",
          "options": [
            {"value": "spouse", "label": "בן/בת זוג"},
            {"value": "children_under18", "label": "ילדים מתחת לגיל 18"},
            {"value": "children_18_24", "label": "ילדים בין גיל 18 ל-24"},
            {"value": "parents", "label": "הורים"},
            {"value": "other", "label": "אחרים"}
          ],
          "impacts": ["תוספות תלויים"]
        }
      ]
    },
    {
      "id": "section_2",
      "title": "חלק ג׳ - מצב כלכלי",
      "description": "מידע כלכלי ונכסים",
      "questions": [
        {
          "id": "q2_income_sources",
          "type": "checkbox",
          "required": true,
          "text": "מהם מקורות ההכנסה שלך? (ניתן לבחור יותר מאחד)",
          "options": [
            {"value": "work", "label": "עבודה"},
            {"value": "pension", "label": "פנסיה"},
            {"value": "senior_pension", "label": "קצבת אזרח ותיק"},
            {"value": "rental", "label": "השכרת נכס"},
            {"value": "none", "label": "אין הכנסה קבועה"}
          ]
        },
        {
          "id": "q2_income_level",
          "type": "radio",
          "required": true,
          "text": "סך הכנסה חודשית משוערת (ברוטו)",
          "options": [
            {"value": "below_threshold", "label": "מתחת לתקרת השלמת הכנסה"},
            {"value": "above_threshold", "label": "מעל התקרה"},
            {"value": "unknown", "label": "לא יודע / לא בטוח"}
          ],
          "impacts": ["השלמת הכנסה", "הבטחת הכנסה"]
        },
        {
          "id": "q2_assets",
          "type": "checkbox",
          "required": true,
          "text": "אילו נכסים יש לך?",
          "options": [
            {"value": "apartment", "label": "דירה נוספת"},
            {"value": "savings", "label": "חסכונות / ניירות ערך"},
            {"value": "none", "label": "אין"}
          ],
          "impacts": ["השלמת הכנסה"]
        },
        {
          "id": "q2_household_benefits",
          "type": "checkbox",
          "required": true,
          "text": "האם מישהו מבני הבית מקבל קצבה/תגמולים מהביטוח הלאומי?",
          "options": [
            {"value": "senior", "label": "אזרח ותיק"},
            {"value": "disability", "label": "נכות"},
            {"value": "nursing", "label": "סיעוד"},
            {"value": "survivors", "label": "שאירים"},
            {"value": "none", "label": "אף אחד"}
          ]
        },
        {
          "id": "q2_economic_hardship",
          "type": "radio",
          "required": true,
          "text": "האם אתה במצב כלכלי חריג?",
          "options": [
            {"value": "yes", "label": "כן"},
            {"value": "no", "label": "לא"}
          ],
          "impacts": ["מענקים חד־פעמיים"]
        },
        {
          "id": "q2_kibbutz",
          "type": "radio",
          "required": true,
          "text": "האם אתה חבר קיבוץ או מושב שיתופי?",
          "options": [
            {"value": "kibbutz_shitufi", "label": "קיבוץ שיתופי"},
            {"value": "kibbutz_mithadesh", "label": "קיבוץ מתחדש"},
            {"value": "moshav_shitufi", "label": "מושב שיתופי"},
            {"value": "no", "label": "לא"}
          ],
          "impacts": ["אופן חישוב הכנסה"],
          "critical": true
        },
        {
          "id": "q2_vehicles",
          "type": "radio",
          "required": true,
          "text": "כמה כלי רכב בבעלותך או בשימוש קבוע?",
          "options": [
            {"value": "none", "label": "אין"},
            {"value": "one", "label": "רכב אחד"},
            {"value": "two", "label": "שני רכבים"},
            {"value": "three_plus", "label": "שלושה ומעלה"}
          ],
          "impacts": ["השלמת הכנסה"]
        }
      ]
    },
    {
      "id": "section_3",
      "title": "חלק ד׳ - מצב בריאותי ותפקודי",
      "description": "מידע על בריאות וניידות",
      "questions": [
        {
          "id": "q3_household_disability",
          "type": "radio",
          "required": true,
          "text": "האם למישהו מבני ביתך מוגדרת נכות?",
          "options": [
            {"value": "yes", "label": "כן"},
            {"value": "no", "label": "לא"}
          ],
          "impacts": ["נכות"]
        },
        {
          "id": "q3_household_nursing",
          "type": "radio",
          "required": true,
          "text": "האם מישהו מבני בית חולה סיעודי?",
          "options": [
            {"value": "yes", "label": "כן"},
            {"value": "no", "label": "לא"}
          ],
          "impacts": ["סיעוד"]
        },
        {
          "id": "q3_household_mobility",
          "type": "radio",
          "required": true,
          "text": "האם מישהו מבני ביתך מוגבל בניידות?",
          "options": [
            {"value": "yes", "label": "כן"},
            {"value": "no", "label": "לא"}
          ],
          "impacts": ["ניידות"]
        },
        {
          "id": "q3_work_injury",
          "type": "radio",
          "required": true,
          "text": "האם מישהו מבני הבית מוגדר כנפגע תאונת עבודה?",
          "options": [
            {"value": "yes", "label": "כן"},
            {"value": "no", "label": "לא"}
          ],
          "impacts": ["פגיעה בעבודה"]
        },
        {
          "id": "q3_pregnancy",
          "type": "radio",
          "required": true,
          "text": "האם את או מישהו מבני הבית בהריון?",
          "options": [
            {"value": "yes", "label": "כן"},
            {"value": "no", "label": "לא"}
          ],
          "impacts": ["דמי לידה"]
        },
        {
          "id": "q3_hostage_victim",
          "type": "radio",
          "required": true,
          "text": "האם מישהו מבני הבית מוגדר נפגע פעולות איבה?",
          "options": [
            {"value": "yes", "label": "כן"},
            {"value": "no", "label": "לא"}
          ],
          "impacts": ["נפגעי פעולות איבה"]
        },
        {
          "id": "q3_medical_hardship",
          "type": "radio",
          "required": true,
          "text": "האם אתה במצב רפואי/תפקודי חריג?",
          "options": [
            {"value": "yes", "label": "כן"},
            {"value": "no", "label": "לא"}
          ],
          "impacts": ["סיעוד", "שירותים מיוחדים"]
        }
      ]
    },
    {
      "id": "section_4",
      "title": "חלק ה׳ - בדיקת זכויות",
      "description": "אילו זכויות תרצה לחקור?",
      "questions": [
        {
          "id": "q4_benefits_check",
          "type": "checkbox",
          "required": true,
          "text": "אילו זכויות תרצה לחקור? (בחר את הרלוונטיות לך)",
          "options": [
            {"value": "senior_citizen", "label": "קצבת אזרח ותיק וזכויות גיל"},
            {"value": "disability", "label": "קצבת נכות"},
            {"value": "nursing", "label": "גמלת סיעוד"},
            {"value": "income_supplement", "label": "השלמת / הבטחת הכנסה"},
            {"value": "survivors", "label": "קצבות שאירים"},
            {"value": "work_injury", "label": "זכויות נפגעי עבודה"},
            {"value": "hostage_victims", "label": "זכויות נפגעי פעולות איבה"},
            {"value": "maternity", "label": "דמי לידה וקצבות אמהות"},
            {"value": "unemployment", "label": "דמי אבטלה"},
            {"value": "mobility", "label": "זכויות ניידות"},
            {"value": "children_benefits", "label": "קצבת ילדים"},
            {"value": "child_disability", "label": "זכויות ילדים עם מוגבלות"},
            {"value": "special_grants", "label": "מענקים חד־פעמיים"},
            {"value": "support_services", "label": "שירותים וסיוע"}
          ]
        }
      ]
    }
  ]
}
